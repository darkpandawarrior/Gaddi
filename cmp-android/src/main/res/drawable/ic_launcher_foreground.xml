<?xml version="1.0" encoding="utf-8"?>
<!--
    GADDI adaptive icon foreground — "the nameplate" mark.

    An enamel station nameplate, chamfered, printed slightly wrong:
      • Chamfered frame  = the License Raj nameplate, corners cut at one unit
      • Seat + leg       = the gaddi (seat) inscribed on the plate
      • Brass coin       = the coin on the plate, structural rather than decorative
      • Ghost frame       = the same outline repeated one module right at half
                            weight — the two-colour misregistration a cheap
                            print run leaves behind

    Colors:
      • Structure + ghost: gold  #E8C874  (Antique Gold)
      • Coin:               brass #C99A3B (Aged Brass)
    Background is defined separately in ic_launcher_background.xml.

    Drawn on the family's 48-unit grid, centred in the 66dp safe zone of the
    108x108 canvas (translate 21,21 / scale 1.375 = 66/48). See
    docs/brand/BRAND.md and the shared brand system doc for the grammar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="1.375"
        android:scaleY="1.375">

        <!-- Nameplate frame, chamfered corners (structure weight) -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#E8C874"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M12,14 L36,14 L40,18 L40,30 L36,34 L12,34 L8,30 L8,18 Z" />

        <!-- Seat, inscribed on the plate -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#E8C874"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M16,26 L28,26" />

        <!-- Leg -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#E8C874"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M24,26 L24,30" />

        <!-- Ghost: the frame repeated one module right, at trace weight —
             the misprint the brand doc opens with, made structural -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#E8C874"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M16,14 L40,14 L44,18 L44,30 L40,34 L16,34 L12,30 L12,18 Z" />

        <!-- Brass coin, on the plate -->
        <path
            android:fillColor="#C99A3B"
            android:pathData="M32,27 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    </group>

</vector>
